# AmbiFlux control plane configuration.
#
# Copy to .env.local for development. Never commit a filled-in copy: .gitignore
# blocks .env* for exactly this reason.
#
# On the hosts, set these in the dashboard instead of a file:
#   Vercel    - Project -> Settings -> Environment Variables
#   Hostinger - hPanel -> your app -> environment variables

# ── Licence signing (the one real secret) ──────────────────────────────────
# Ed25519 private key, base64 DER. Generate with `npm run keygen`.
#
# Anyone holding this can mint valid licences for your product. Required in
# production - the app refuses to serve without it. In development a throwaway
# key is generated per start, with a warning, so `npm run dev` works out of the box.
#
# Never name it NEXT_PUBLIC_*. Next inlines anything with that prefix into the
# browser bundle, and config.ts fails the boot if it catches a secret named that way.
LICENCE_SIGNING_KEY=

# ── Database (Supabase) ────────────────────────────────────────────────────
# STORAGE is inferred: "supabase" as soon as SUPABASE_URL is set, otherwise
# "memory". Production refuses to start on "memory" because both hosts stop an
# idle app, which would wipe every activation and preset.
SUPABASE_URL=https://your-project.supabase.co

# The SERVICE ROLE key, not the anon key. It bypasses row level security, which
# is required here: the tables have RLS enabled with no policies, so the anon key
# reads nothing by design. Settings -> API -> service_role. Secret.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, and only read by `npm run migrate`. Setting it lets the schema check
# verify that the public anon key really cannot read the licences table.
SUPABASE_ANON_KEY=

# ── Licence policy ─────────────────────────────────────────────────────────
# Token lifetime, and how long a client keeps working past expiry.
#
# The grace window is the fail-open budget: a customer whose refresh cannot reach
# us keeps their lights working instead of going dark because our host was asleep.
# Adobe allows 99 days, Microsoft 365 about 32. Two weeks is already strict.
LICENCE_TTL_DAYS=30
LICENCE_GRACE_DAYS=14

# ── Rate limiting ──────────────────────────────────────────────────────────
# Per client address, per route, per window. In-process: a correct global limit
# on a single long-lived Hostinger process, and per-instance on Vercel. See
# lib/ratelimit.ts for why that trade is accepted rather than hidden.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ── Misc ───────────────────────────────────────────────────────────────────
# Extra allowed origins, comma separated. Empty means same-origin only, which is
# correct when the panel and the API are one deployment.
CORS_ORIGINS=
LOG_LEVEL=info
