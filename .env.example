# Copy to .env for local development. On Hostinger, set these in
# your app's environment variables instead - never commit a real .env.

# ── Required in production ─────────────────────────────────────────
NODE_ENV=production

# Ed25519 private key (base64 DER, PKCS8). Generate with: npm run keygen
# Anyone holding this can mint valid licences. Treat it like a payment key.
# Rotating it invalidates every token in the field; clients re-activate on
# their next refresh.
LICENCE_SIGNING_KEY=

# ── Database ───────────────────────────────────────────────────────
# Setting DB_HOST switches STORAGE to mysql automatically. Production refuses
# to start on the in-memory driver, because Hostinger stops an idle process
# and that would wipe every activation and preset.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=4

# ── Optional ───────────────────────────────────────────────────────
# PORT is supplied by Hostinger. Only set it locally.
# PORT=3000
# HOST=0.0.0.0

# Licence token lifetime and how long a client keeps working past expiry.
# The grace window is deliberately generous: the engine must not go dark
# because the licence server was asleep when a refresh was due.
LICENCE_TTL_DAYS=30
LICENCE_GRACE_DAYS=14

# Empty means same-origin only, which is correct when the page and the API are
# one deployment. Add origins only if the engine calls from somewhere else.
CORS_ORIGINS=

# Where the built frontend lands. Whichever UI kit is chosen only has to emit
# static files here; the API serves them from the same process.
WEB_DIR=web/dist

LOG_LEVEL=info
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Hostinger terminates TLS in front of the app, so client addresses arrive via
# X-Forwarded-For. Rate limiting does nothing without this.
TRUST_PROXY=true
