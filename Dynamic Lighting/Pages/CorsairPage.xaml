<Page
    x:Class="Dynamic_Lighting.Pages.CorsairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <StackPanel Padding="24" Spacing="12">
        <TextBlock Text="Corsair iCUE Link Hub Controller" FontSize="28" FontWeight="Bold"/>
        <TextBlock x:Name="ConnectionStatusText" Text="Corsair status" TextWrapping="Wrap"/>
        <StackPanel x:Name="DeviceListPanel" Spacing="8"/>
        <Grid x:Name="CorsairColorPickerHost"/>
        <Button x:Name="ApplyColorButton" Content="Apply Color" Click="ApplyColorButton_Click"/>
        <ToggleButton x:Name="LivePreviewToggle" Content="Live Preview" IsChecked="False" Click="LivePreviewToggle_Click"/>
        <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap"/>
    </StackPanel>
</Page>
