# ── Node ───────────────────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
*.log
npm-debug.log*

# ── Next.js build output ───────────────────────────────────────────
# AGENTS.md and CLAUDE.md are also generated by `next dev`, but they are
# committed on purpose: the generator re-adds them, so ignoring them would leave
# the tree permanently dirty.
.next/
next-env.d.ts
*.tsbuildinfo

# ── Secrets ────────────────────────────────────────────────────────
# LICENCE_SIGNING_KEY can mint valid licences. It belongs in the host's
# environment variables, never in the repo.
.env
.env.*
!.env.example

# ── Local development data ─────────────────────────────────────────
server/.data/

# ── Firmware build output (PlatformIO) ─────────────────────────────
.pio/
.pioenvs/
.piolibdeps/

# ── Editors and OS ─────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# Extension build output; load extension/dist unpacked
extension/dist/

# Scratch tests written while probing a module by hand; never part of the suite that ships.
test/_probe*

# Extension release package produced by `npm run pack:extension`
extension/*.zip
extension/.pack/
