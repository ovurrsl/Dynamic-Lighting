{
  "appName": { "message": "AmbiFlux" },
  "appDescription": { "message": "Ekranı takip eden ambilight motoru: yakalama, örnekleme ve seri port. Panel: ambiflux-revor.vercel.app" },

  "pairSerial": { "message": "Seri portu eşleştir" },
  "startCapture": { "message": "Yakalamayı başlat" },
  "stop": { "message": "Durdur" },
  "selfTest": { "message": "Ekransız sına" },

  "statusPaired": {
    "message": "Port eşleşti (VID $VID$, PID $PID$).\nMotor bağlanıyor…",
    "placeholders": {
      "vid": { "content": "$1", "example": "2341" },
      "pid": { "content": "$2", "example": "0070" }
    }
  },
  "statusSerialReply": {
    "message": "Seri: $REPLY$",
    "placeholders": { "reply": { "content": "$1" } }
  },
  "statusNoPort": {
    "message": "Port seçilmedi: $REASON$",
    "placeholders": { "reason": { "content": "$1" } }
  },
  "statusPickerOpening": { "message": "Ekran seçici açılıyor…" },
  "statusCaptureRunning": { "message": "Yakalama çalışıyor." },
  "statusStartFailed": {
    "message": "Başlatılamadı: $REASON$",
    "placeholders": { "reason": { "content": "$1" } }
  },
  "statusSelfTestRunning": { "message": "Sınama çalışıyor: motor üretilmiş bir resmi işliyor." },
  "statusSelfTestFailed": {
    "message": "Sınama başlatılamadı: $REASON$",
    "placeholders": { "reason": { "content": "$1" } }
  },
  "statusStopped": {
    "message": "Durduruldu: $REPLY$",
    "placeholders": { "reply": { "content": "$1" } }
  },
  "statusEngine": {
    "message": "Motor: $STATE$ · v$VERSION$",
    "placeholders": {
      "state": { "content": "$1", "example": "idle" },
      "version": { "content": "$2", "example": "0.1.0" }
    }
  }
}
