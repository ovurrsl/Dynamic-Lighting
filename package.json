{
  "name": "ambiflux",
  "version": "0.1.0",
  "private": true,
  "description": "Screen-following ambilight: hosted control plane, browser capture engine and ESP32-S3 firmware",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "build:extension": "node scripts/build-extension.mjs",
    "pack:extension": "node scripts/pack-extension.mjs",
    "typecheck:extension": "tsc -p extension --noEmit",
    "hyperion:watch": "node scripts/hyperion-watch.mjs",
    "bench": "node scripts/bench-pipeline.ts",
    "verify": "npm run typecheck && npm run typecheck:extension && npm test && npm run build && npm run verify:extension",
    "verify:extension": "npm run build:extension && rm -f extension/dist/*.map && { git diff --quiet -- extension/dist || { echo 'extension/dist kaynakla eşleşmiyor: build:extension çıktısını commit et'; git diff --stat -- extension/dist; exit 1; }; }"
  },
  "dependencies": {
    "@heroui/react": "~3.2.5",
    "@heroui/styles": "~3.2.5",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-serial": "^1.0.8",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "imports": {
    "#lib/*": "./lib/*.ts",
    "#data/*": "./data/*.ts",
    "#components/*": "./components/*.tsx",
    "#test/*": "./test/*.ts"
  }
}
