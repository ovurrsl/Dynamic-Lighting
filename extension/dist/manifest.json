{
  "manifest_version": 3,
  "name": "AmbiFlux",
  "version": "0.1.0",
  "description": "Ekranı takip eden ambilight motoru: yakalama, örnekleme ve seri port. Panel: ambiflux-revor.vercel.app",
  "minimum_chrome_version": "116",
  "permissions": ["offscreen", "storage"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AmbiFlux"
  },
  "externally_connectable": {
    "matches": [
      "https://ambiflux-revor.vercel.app/*",
      "https://ambiflux.vercel.app/*"
    ]
  },
  "key": ""
}
