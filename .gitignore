# ── Node ───────────────────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
*.log
npm-debug.log*

# ── Next.js build output ───────────────────────────────────────────
# AGENTS.md and CLAUDE.md are also generated by `next dev`, but they are
# committed on purpose: the generator re-adds them, so ignoring them would leave
# the tree permanently dirty.
.next/
next-env.d.ts
*.tsbuildinfo

# ── Secrets ────────────────────────────────────────────────────────
# LICENCE_SIGNING_KEY can mint valid licences. It belongs in the host's
# environment variables, never in the repo.
.env
.env.*
!.env.example

# ── Local development data ─────────────────────────────────────────
server/.data/

# ── Firmware build output (PlatformIO) ─────────────────────────────
.pio/
.pioenvs/
.piolibdeps/

# ── Editors and OS ─────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# Extension build output IS committed: it is what "load unpacked" needs, and
# keeping it out of the repo made downloading a working extension impossible
# without a toolchain. Regenerate with `npm run build:extension` before pushing.
# The source maps are not: four times the size of the code and useless without
# the sources, which are right here anyway.
#
# The un-ignore has to name every level, because git will not descend into a
# directory it has already excluded - the bare `dist/` at the top of this file
# would otherwise hide all of this.
!extension/dist/
!extension/dist/*
extension/dist/*.map

# Scratch tests written while probing a module by hand; never part of the suite that ships.
test/_probe*

# Packaging scratch. The zip itself is a release asset, not a tracked file.
extension/*.zip
extension/.pack/
