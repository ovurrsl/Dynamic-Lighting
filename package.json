{
  "name": "ambiflux",
  "version": "0.1.0",
  "private": true,
  "description": "Screen-following ambilight: hosted control plane, local capture engine and ESP32-S3 firmware",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "build": "npm run build:web --if-present",
    "dev": "node --watch server/src/index.js",
    "test": "node --test \"server/test/*.test.js\"",
    "keygen": "node server/src/scripts/keygen.js",
    "migrate": "node server/src/scripts/migrate.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "mysql2": "^3.24.4"
  }
}
